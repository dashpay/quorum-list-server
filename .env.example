# ===========================================
# Quorum List Server - Docker Compose Config
# ===========================================
# Copy to .env and configure values
#
# Two modes of operation:
#   Standalone: docker compose --profile standalone up
#   Shared:     docker compose up (uses external Dash Core)

# REQUIRED: Network selection (mainnet, testnet, or regtest)
DASH_NETWORK=testnet

# REQUIRED: RPC password - must match Dash Core's rpcpassword
DASH_RPC_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# REQUIRED: RPC port (must match network)
# mainnet=9998, testnet=19998, regtest=19898
DASH_RPC_PORT=19998

# Optional: RPC host
# - Standalone mode: set to "dashcore" (uses bundled Dash Core)
# - Shared mode: default "faucet-dashcore" (uses dash-net network)
# DASH_RPC_HOST=dashcore

# Optional: RPC username (default: dashrpc)
DASH_RPC_USER=dashrpc

# Optional: API server port (default: 3000)
API_PORT=3000

# Optional: Quorum configuration
QUORUM_PREVIOUS_BLOCKS_OFFSET=8
QUORUM_CACHE_TTL_SECONDS=60
